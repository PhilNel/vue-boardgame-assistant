{
  "name": "boardgame-warlock",
  "version": "1.0.0",
  "description": "Boardgame Warlock - Your magical AI assistant for board game rules and gameplay",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite",
    "build": "NODE_ENV=production vite build",
    "build:s3": "bun scripts/build-for-s3.js",
    "deploy:s3": "bun scripts/deploy-to-s3.js",
    "invalidate": "bun scripts/invalidate-cloudfront.js",
    "preview": "vite preview",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.0",
    "axios": "^1.10.0",
    "pinia": "^3.0.3",
    "uuid": "^9.0.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "terser": "^5.43.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.57.2",
    "vite": "^5.0.0",
    "vue-tsc": "^3.2.6"
  }
}
